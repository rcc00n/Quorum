[Unit]
Description=Quorum Next.js user portal
After=network.target
[Service]
User=quorum
Group=quorum
WorkingDirectory=/opt/quorum/current/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3017
Environment=NODE_OPTIONS=--max-old-space-size=160
ExecStart=/opt/quorum/runtime/node server.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quorum
MemoryMax=256M
CPUQuota=50%
[Install]
WantedBy=multi-user.target
