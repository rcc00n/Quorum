# Copy to .env with mode 600. Literal KEY=value only; no shell expansion.
# smoke_test.py reads .env. scripts/checks.py also accepts .env.local.
# Each team member keeps their own copy with their own values. Never commit it.
# The supplied Zetaris platform bundle stays outside this repository; its admin,
# database and image credentials live only in the bundle's own private .env.

# ---- Zetaris (Data): client settings for THIS machine's local install ----
# smoke_test.py reads these. ZETARIS_API_KEY is the key you create in the web UI.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Only for downloading the API specification. SQL uses the API key above, not these.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# ---- Power: the three settings smoke_test.py reads, all from the same route ----
# Nightshift Console on this machine, not an organizer-issued URL. Local example is shown.
# On that route NEMOTRON_MODEL is meterless/auto or a meterless/* lane, not an NVIDIA model id.
# A direct NVIDIA route uses that route's own base URL, key and model id instead.
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=
NEMOTRON_MODEL=meterless/auto
# Power 4.5 names for the same three values. checks.py uses them when the MODEL_* lines above are empty.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=

# ---- Local paths. These names are read by scripts in this repo; blanks keep documented defaults. ----
# ZETARIS_PLATFORM_DIR: scripts/services.py. METERLESS_HOME: scripts/checks.py,
# scripts/setup-meterless.sh, scripts/meterless-persistence.mjs.
# CURSOR_EXE and CURSOR_ACCEPTANCE_FILE: scripts/checks.py (see docs/MANUAL_ACTIONS.md).
ZETARIS_PLATFORM_DIR=
METERLESS_HOME=
CURSOR_EXE=
CURSOR_ACCEPTANCE_FILE=
