# Copy to .env with mode 600. Literal KEY=value only; no shell expansion.
# smoke_test.py reads .env. scripts/checks.py also accepts .env.local.
# Each team member keeps their own copy with their own values. Never commit it.
# The supplied Zetaris platform bundle stays outside this repository; its admin,
# database and image credentials live only in the bundle's own private .env.

# ---- Zetaris (Data): client settings for THIS machine's local install ----
# smoke_test.py reads these. ZETARIS_API_KEY is the key you create in the web UI.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Only for downloading the API specification. SQL uses the API key above, not these.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# ---- Power: the three settings smoke_test.py reads, all from the same route ----
# Nightshift Console on this machine, not an organizer-issued URL. Local example is shown.
# On that route NEMOTRON_MODEL is meterless/auto or a meterless/* lane, not an NVIDIA model id.
# A direct NVIDIA route uses that route's own base URL, key and model id instead.
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=
NEMOTRON_MODEL=meterless/auto
# Reasoning's second lane: the blind fact-checker. Pin a different Nemotron route here (list them with
# `python -m quorum_reasoning.run --models`); empty = same route as NEMOTRON_MODEL. Through Nightshift 1.2.3 the
# explicit id nvidia/nemotron-3-ultra-550b-a55b selects Ultra (observed 2026-10-23, five of five requests), while
# meterless/deep and meterless/judge rank onto the same Lightning lane as fast; `--test-connection` must show both
# models before a run. The Windows runtime listens on Windows loopback 127.0.0.1:8088 only: run reasoning from a
# Windows Python venv, not from WSL2 under NAT (docs/reviews/2026-10-23-nemotron-routing.md, addendum).
NEMOTRON_MODEL_FACT_CHECKER=
# Third lane: the blind reviewer of claims the two checks disagree on (nodes/review_disputed.py). Empty = the
# fact-checker's route (a different model than the verifier's lane when that is pinned).
NEMOTRON_MODEL_REVIEWER=
# Development alternative: NVIDIA's hosted endpoint directly (same three names, different values). Nightshift
# stays the product's primary provider; the direct route is for development runs when the hotspot does not
# pass request fields through (see reasoning/README.md › Decisions, 2026-10-23). Never commit the key.
#   MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#   MODEL_API_KEY=<nvapi-… key from build.nvidia.com>
#   NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#   NEMOTRON_MODEL_FACT_CHECKER=nvidia/nemotron-3-ultra-550b-a55b
# nemotron-3-super-120b-a12b has returned 404 "Function not found for account" for every account since
# ~2026-10-20 (NVIDIA-side); Ultra-550B and nemotron-3.5-super-vl-120b-a12b kept serving. Avoid
# llama-3.3-nemotron-super-49b-v1.5 here: its thinking switch is a system-prompt "/no_think", not
# chat_template_kwargs, so our reasoning=off control would not reach it (docs/reviews/2026-10-23-nemotron-routing.md).
# Power 4.5 names for the same three values. checks.py uses them when the MODEL_* lines above are empty.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=

# ---- Local paths. These names are read by scripts in this repo; blanks keep documented defaults. ----
# ZETARIS_PLATFORM_DIR: scripts/services.py. METERLESS_HOME: scripts/checks.py,
# scripts/setup-meterless.sh, scripts/meterless-persistence.mjs.
# CURSOR_EXE and CURSOR_ACCEPTANCE_FILE: scripts/checks.py (see docs/MANUAL_ACTIONS.md).
ZETARIS_PLATFORM_DIR=
METERLESS_HOME=
CURSOR_EXE=
CURSOR_ACCEPTANCE_FILE=

# ---- Reasoning block (reasoning/): switches only, no secrets. See reasoning/README.md ----
# QUORUM_DRY_RUN=1 forces model stand-ins (no credits) whatever the CLI/Studio input says.
QUORUM_DRY_RUN=
# Lightning datasource name the collectors registered (collectors/zetaris/01_register_postgres.sql).
# Tables are <name>.documents etc.; set the SCHEMA only if your registration exposes a schema level.
ZETARIS_COLLECTION_DB=QUORUM_COLLECT
ZETARIS_COLLECTION_SCHEMA=
# Fixture day for --corpus fixture: sample_day (default) or usecases/<name>.
QUORUM_FIXTURE=
# Checkout of the data-collection branch (repository root) when collectors/ is not in this tree: the live run then
# reads article text through the one shared fetcher, collectors.common.fetch_text. Empty = this repository root.
QUORUM_COLLECTORS_PATH=
# Pause between live model calls in ms; empty = config/reasoning.toml (1600). 0 through Nightshift, which paces upstream.
QUORUM_MIN_INTERVAL_MS=
