# Copy to .env.local; chmod 600 .env.local. Literal KEY=value only; no shell expansion.
# Blank credentials intentionally BLOCK integration checks.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
# Optional exact health URL provided by your instance's documentation.
ZETARIS_HEALTH_URL=
# Absolute external directory containing the official matching bundle and private .env.
ZETARIS_BUNDLE_DIR=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
# Optional absolute paths; defaults are ~/.local/share/quorum/meterless and detected Cursor.
METERLESS_HOME=
CURSOR_EXE=
