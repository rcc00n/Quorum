# Copy to .env.local with mode 600. Literal KEY=value only; no shell expansion.
# Supplied platform bundle stays outside Quorum. Blank uses the documented external path.
ZETARIS_PLATFORM_DIR=
# Administrator, database and image values live only in the bundle's supplied private .env.
# Do not duplicate credentials in this repository's configuration.
# Exact organizer-issued API base URL (including version path), key and Nemotron model ID.
METERLESS_BASE_URL=
METERLESS_API_KEY=
NEMOTRON_MODEL=
METERLESS_HOME=
CURSOR_EXE=
# Optional external acceptance record; see docs/MANUAL_ACTIONS.md.
CURSOR_ACCEPTANCE_FILE=
