# Copy to .env.local with mode 600. Literal KEY=value only; no shell expansion.
# Freemium checkout/runtime stay outside Quorum; blank paths use ~/.local/share/quorum defaults.
ZETARIS_FREEMIUM_HOME=
ZETARIS_RUNTIME_DIR=
ZETARIS_GUI_URL=http://127.0.0.1:9001
# Exact documented REST endpoint returning an identifiable API JSON response; do not guess.
ZETARIS_REST_CHECK_URL=
ZETARIS_API_KEY=
# Until Freemium's actual REST query contract is available, use the documented JDBC route.
ZETARIS_JDBC_JAR=
ZETARIS_JDBC_DRIVER=
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@127.0.0.1:10000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Organizer-provided sample SELECT from a REGISTERED dataset, not SELECT 1.
ZETARIS_DATASET_SQL=
# Exact organizer-issued API base URL (including version path), key and Nemotron model ID.
METERLESS_BASE_URL=
METERLESS_API_KEY=
NEMOTRON_MODEL=
METERLESS_HOME=
CURSOR_EXE=
# Optional external acceptance record; see docs/MANUAL_ACTIONS.md.
CURSOR_ACCEPTANCE_FILE=
