DJANGO_DEBUG=1
# Production requires a random secret set outside the checkout.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# QUORUM_PORTAL_DATA defaults to ~/.local/share/quorum/portal
# Login-only reader for installed reasoning 1.0 editions (README › Control and checks); off unless both are set.
# QUORUM_ENABLE_REASONING_READER=1
# QUORUM_REASONING_EDITIONS_ROOT=/absolute/private/directory/filled/by/reasoning_snapshot-install
