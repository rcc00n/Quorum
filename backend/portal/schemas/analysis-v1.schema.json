          "type": "string",
          "format": "utc-timestamp"
        },
        "action": {
          "enum": [
            "collection",
            "clustering",
            "claim_extraction",
            "evidence_search",
            "zetaris_query",
            "primary_verification",
            "independent_verification",
            "contradiction_detection",
            "recheck",
            "conclusion_revision",
            "publication"
