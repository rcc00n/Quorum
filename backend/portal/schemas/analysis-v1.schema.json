{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "quorum.portal.snapshot.v1-proposal"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "parent_revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "edition": {
      "type": "string",
      "format": "edition-date"
    },
    "generated_at": {
      "type": "string",
      "format": "utc-timestamp"
    },
    "expires_at": {
      "type": "string",
      "format": "utc-timestamp"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "live",
        "demo"
      ]
    },
    "completeness": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      },
      "maxItems": 50
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      },
      "maxItems": 50
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 200
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "maxItems": 200
    },
    "digests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/digest"
      },
      "maxItems": 200
    }
  },
  "required": [
    "schema_version",
    "revision",
    "parent_revision",
    "run_id",
    "edition",
    "generated_at",
    "expires_at",
    "source_revision",
    "mode",
    "completeness",
    "errors",
    "topics",
    "sources",
    "events",
    "digests"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quorum:portal:snapshot:v1-proposal",
  "title": "PROPOSAL \u2014 portal-owned snapshot envelope; reasoning contract not approved",
  "$defs": {
    "topic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "domain": {
          "type": "string",
          "maxLength": 253,
          "format": "public-domain"
        },
        "audience": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "allsides": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mbfc": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "adfontes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "agency",
            "outlet",
            "official",
            "military"
          ]
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "major",
                "minor"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "independence_group": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "audience_source_url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "format": "public-url"
            },
            {
              "type": "null"
            }
          ]
        },
        "audience_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "edition-date"
            },
            {
              "type": "null"
            }
          ]
        },
        "rating_provenance": {
          "type": "object",
          "properties": {
            "allsides": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "public-url"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mbfc": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "public-url"
                },
                {
                  "type": "null"
                }
              ]
            },
            "adfontes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "public-url"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "allsides",
            "mbfc",
            "adfontes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "audience",
        "allsides",
        "mbfc",
        "adfontes",
        "kind",
        "tier",
        "independence_group",
        "audience_source_url",
        "audience_as_of",
        "rating_provenance"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "public-url"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "utc-timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "utc-timestamp"
        },
        "access_level": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "kind": {
          "enum": [
            "article",
            "official"
          ]
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_id",
        "title",
        "url",
        "content_hash",
        "revision",
        "published_at",
        "fetched_at",
        "access_level",
        "kind",
        "primary"
      ],
      "additionalProperties": false
