            "summary": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                },
                {
                  "type": "null"
                }
              ]
            },
            "actor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "utc-timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "summary",
            "actor",
            "checked_at"
          ],
          "additionalProperties": false
        },
        "independent_verification": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "confirmed",
                "not_confirmed",
                "contradicted",
                "not_run"
              ]
            },
            "summary": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                },
                {
                  "type": "null"
                }
              ]
            },
            "actor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "utc-timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "summary",
            "actor",
            "checked_at"
          ],
          "additionalProperties": false
        },
        "disagreement": {
          "enum": [
            "none",
            "present",
            "not_assessed"
          ]
        },
        "confidence_explanation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "status",
        "explanation",
        "attribution",
        "supporting",
        "contradicting",
        "primary_verification",
        "independent_verification",
        "disagreement",
        "confidence_explanation"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "source_id": {
